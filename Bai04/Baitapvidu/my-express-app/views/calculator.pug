
doctype html
html
    head
        title Ung dung tinh toan
        meta(charset="UTF-8")
        link(rel="stylesheet", href="/styles.css")
    body
        .container
            h1 UNG DUNG TINH TOAN
            form(action="/calculator/calculate", method="POST")
                label So thu nhat:
                input(type="number", step="any", name="num1", required)

                label So thu hai:
                input(type="number", step="any", name="num2", required)

                label Chon phep tinh:
                select(name="operation")
                    option(value="add") Cong (+)
                    option(value="subtract") Tru (-)
                    option(value="multiply") Nhan (*)
                    option(value="divide") Chia (/)

                button(type="submit") Tinh ket qua

            if result !== null
                h2 Ket qua: #{result}

            if error
                h2.error Loi: #{error}
